# SHOBDOX — environment example
#
# This file is documentation, not a requirement: the demo runs with **no**
# environment variables at all. Copy it to `.env.local` only if you want to
# override the optional display values below.
#
#   cp .env.example apps/web/.env.local
#
# Anything prefixed with `VITE_` is embedded in the built JavaScript bundle, so
# never put a secret here. There are no secrets in this project.

# ---------------------------------------------------------------------------
# Optional — brand copy shown in the header, footer and share previews.
# ---------------------------------------------------------------------------
VITE_APP_NAME=SHOBDOX
VITE_APP_TAGLINE=বাংলার ডিজিটাল বাজার
VITE_SUPPORT_PHONE=09612345678

# ---------------------------------------------------------------------------
# Optional — demo behaviour
# ---------------------------------------------------------------------------

# Adds an artificial delay (ms) to mock "network" reads so loading skeletons
# are visible when presenting the demo. 0 disables. Default: 0.
VITE_MOCK_LATENCY_MS=0

# Shows the demo-data reset button in the footer. Default: true.
VITE_SHOW_DEMO_CONTROLS=true

# ---------------------------------------------------------------------------
# Not used in this phase — reserved for the backend integration described in
# the README ("Backend integration plan"). The demo never calls a network API,
# never authenticates and never handles payment credentials.
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://api.example.com
# VITE_PAYMENT_GATEWAY_PUBLIC_KEY=pk_demo_not_a_real_key
