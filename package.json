{
  "name": "shobdox",
  "version": "0.1.0",
  "private": true,
  "description": "SHOBDOX — বাংলার ডিজিটাল বাজার. UI/UX design & interactive demo monorepo (web + Android).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "tokens:css": "node packages/design-tokens/scripts/generate-css-tokens.mjs",
    "dev": "pnpm -F @shobdox/web dev",
    "dev:web": "pnpm -F @shobdox/web dev",
    "dev:mobile": "pnpm -F @shobdox/mobile start",
    "android": "pnpm -F @shobdox/mobile android",
    "build": "pnpm -F @shobdox/web build",
    "build:web": "pnpm -F @shobdox/web build",
    "preview": "pnpm -F @shobdox/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:web": "pnpm -F @shobdox/web typecheck",
    "typecheck:mobile": "pnpm -F @shobdox/mobile typecheck",
    "validate:data": "pnpm -F @shobdox/web validate:data",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/web/dist .tmp"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
