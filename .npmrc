# Flat, npm-compatible node_modules.
#
# The linker itself is configured in `pnpm-workspace.yaml` (`nodeLinker`):
# pnpm 12 reads project settings from there, not from this file. This comment
# stays here so the `.npmrc` and the workspace file are not mistaken for two
# competing sources of truth.
#
# A hoisted tree keeps Metro working (it cannot follow per-package symlinks)
# and gives Vite a single hoisted React copy, exactly like npm's workspaces.

# Internal packages are referenced as "*" in the workspace manifests.
link-workspace-packages=true

# React Native ships peer ranges that no single tree satisfies; resolution must
# not fail the install for that reason. Duplicate/incompatible peers are still
# reported by `npm run typecheck` and `expo-doctor`.
strict-peer-dependencies=false
auto-install-peers=true

# Keep lockfile churn low while this repo is not under version control.
prefer-frozen-lockfile=false

# Long timeouts: the demo is often installed on slow connections.
fetch-retries=10
fetch-timeout=600000
