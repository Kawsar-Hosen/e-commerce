{
  "name": "@shobdox/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SHOBDOX responsive e-commerce website (customer, admin and seller interfaces).",
  "scripts": {
    "tokens": "node ../../packages/design-tokens/scripts/generate-css-tokens.mjs",
    "dev": "node ../../packages/design-tokens/scripts/generate-css-tokens.mjs && vite",
    "build": "node ../../packages/design-tokens/scripts/generate-css-tokens.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate:data": "vite build --ssr scripts/validate-dataset.ts --outDir ../../.tmp/validate --emptyOutDir && node ../../.tmp/validate/validate-dataset.js"
  },
  "dependencies": {
    "@shobdox/design-tokens": "workspace:*",
    "@shobdox/shared-business-logic": "workspace:*",
    "@shobdox/shared-mock-data": "workspace:*",
    "@shobdox/shared-types": "workspace:*",
    "@shobdox/shared-utils": "workspace:*",
    "@shobdox/shared-validation": "workspace:*",
    "@tanstack/react-query": "~5.104.4",
    "clsx": "~2.1.1",
    "framer-motion": "~14.3.0",
    "lucide-react": "~1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "~7.90.0",
    "react-router": "~8.4.0",
    "recharts": "~3.10.1",
    "tailwind-merge": "~3.7.0",
    "zod": "~4.6.7",
    "zustand": "~5.0.15",
    "@hookform/resolvers": "~5.9.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "~4.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "tailwindcss": "~4.3.3",
    "vite": "~8.3.4",
    "@types/node": "~26.6.5"
  }
}
